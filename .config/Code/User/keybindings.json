    // --- Additions replicating the rest of the nvim config ---

    // Split navigation: <C-j>/<C-k> move to split below/above (mappings.lua
    // <C-H/J/K/L>). <C-h>/<C-l> already exist above via vim.normalModeKeyBindingsNonRecursive.
    // Scoped to plain editor normal-mode focus so this doesn't collide with
    // the existing ctrl+j/ctrl+k entries used for list/suggestion navigation
    // (those only fire when listFocus/suggestWidget/quickOpen are active).
    {
        "key": "ctrl+j",
        "command": "workbench.action.focusBelowGroup",
        "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.focusAboveGroup",
        "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
    },

    // Resize split: <C-Up/Down/Left/Right> (mappings.lua ~L218). VS Code has
    // no per-direction resize command, only a generic increase/decrease of
    // the focused view's size, so up/left shrink and down/right grow.
    {
        "key": "ctrl+up",
        "command": "workbench.action.decreaseViewSize",
        "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
    },
    {
        "key": "ctrl+down",
        "command": "workbench.action.increaseViewSize",
        "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
    },
    {
        "key": "ctrl+left",
        "command": "workbench.action.decreaseViewSize",
        "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
    },
    {
        "key": "ctrl+right",
        "command": "workbench.action.increaseViewSize",
        "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
    },

    // Terminal navigation: <C-h/j/k/l> move out of the terminal into the
    // editor/sidebar in whichever direction it sits (mappings.lua `t` mode).
    {
        "key": "ctrl+h",
        "command": "workbench.action.navigateLeft",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.navigateDown",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.navigateUp",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.navigateRight",
        "when": "terminalFocus"
    },
